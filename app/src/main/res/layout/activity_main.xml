<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- Logo block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌨️"
                android:textSize="52sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keeb"
                android:textSize="32sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send crypto from any chat app"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Status cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KEYBOARD"
                android:textSize="10sp"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.12"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_keyboard_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checking…"
                android:textSize="14sp"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WALLET"
                android:textSize="10sp"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.12"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_wallet_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checking…"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Primary CTA buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_enable_keyboard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="1.  Enable Keeb in Settings"
            android:textSize="15sp"
            android:backgroundTint="@color/bg_surface"
            android:textColor="@color/blue_primary"
            android:layout_marginBottom="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_switch_keyboard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="2.  Switch to Keeb"
            android:textSize="15sp"
            android:backgroundTint="@color/blue_primary"
            android:textColor="@color/white"
            android:layout_marginBottom="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <!-- Secondary row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_wallet"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="💳  Wallet"
                android:textSize="13sp"
                android:backgroundTint="@color/bg_surface"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_settings"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="⚙  Settings"
                android:textSize="13sp"
                android:backgroundTint="@color/bg_surface"
                android:textColor="@color/text_primary"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Copy a wallet address in Telegram or Discord\nand watch the payment chip appear ✨"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp" />

    </LinearLayout>
</ScrollView>
