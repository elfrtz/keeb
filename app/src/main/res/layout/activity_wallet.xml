<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="32dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_wallet_back"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Wallet"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Status card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="20dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STATUS"
            android:textSize="10sp"
            android:textColor="@color/text_muted"
            android:letterSpacing="0.12"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_wallet_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not Connected"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bg_elevated"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADDRESS"
            android:textSize="10sp"
            android:textColor="@color/text_muted"
            android:letterSpacing="0.12"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_wallet_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Network row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Network"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⬡  Base Sepolia"
            android:textColor="@color/blue_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_wallet_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wallet_hint_setup"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="20dp"
        android:lineSpacingExtra="4dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_connect_metamask"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/wallet_setup_button"
        android:textSize="15sp"
        android:backgroundTint="@color/blue_primary"
        android:textColor="@color/white"
        android:layout_marginBottom="10dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_open_metamask"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/wallet_open_metamask"
        android:textSize="15sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="10dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

    <!-- Disconnect button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_disconnect_wallet"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Disconnect Wallet"
        android:textSize="15sp"
        android:backgroundTint="@color/bg_surface"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/wallet_footer"
        android:textSize="12sp"
        android:textColor="@color/text_muted"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

</LinearLayout>
